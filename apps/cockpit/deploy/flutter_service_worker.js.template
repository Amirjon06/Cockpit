'use strict';
// Cockpit deploy cleanup SW - regenerated every publish.
// build_id: __BUILD_ID__
//
// Clears Cache Storage, unregisters itself, and reloads open tabs so users
// never keep a stale Flutter/PWA cache after a deploy.

const BUILD_ID = '__BUILD_ID__';

self.addEventListener('install', (event) => {
  self.skipWaiting();
});

self.addEventListener('activate', (event) => {
  event.waitUntil((async () => {
    try {
      const keys = await caches.keys();
      await Promise.all(keys.map((key) => caches.delete(key)));
    } catch (e) {
      console.warn('[cockpit-sw] cache clear failed', BUILD_ID, e);
    }

    try {
      await self.registration.unregister();
    } catch (e) {
      console.warn('[cockpit-sw] unregister failed', BUILD_ID, e);
    }

    try {
      const clients = await self.clients.matchAll({ type: 'window' });
      clients.forEach((client) => {
        if (client.url && 'navigate' in client) {
          client.navigate(client.url);
        }
      });
    } catch (e) {
      console.warn('[cockpit-sw] client reload failed', BUILD_ID, e);
    }
  })());
});
